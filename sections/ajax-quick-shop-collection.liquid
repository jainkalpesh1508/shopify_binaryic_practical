
{{ 'ajax-quick-shop.css' | asset_url | stylesheet_tag }}

<section
  class="ajax-quick-shop-collection"
  data-section-id="{{ section.id }}"
>
  <div class="ajax-quick-shop-container">

    {% if section.settings.heading != blank %}
      <div class="ajax-quick-shop-header heading-{{ section.settings.heading_alignment }}">
        <h2>{{ section.settings.heading }}</h2>
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      {% assign selected_collection = section.settings.collection %}

      <div class="ajax-quick-shop-grid">
        {% for product in selected_collection.products
          limit: section.settings.products_to_show
        %}

          <article
            class="ajax-quick-shop-card"
            data-product-handle="{{ product.handle }}"
          >

            <div class="ajax-quick-shop-card-image">
              {% if product.featured_image %}
                <img
                  src="{{ product.featured_image | image_url: width: 600 }}"
                  alt="{{ product.featured_image.alt | escape }}"
                  width="600"
                  height="600"
                  loading="lazy"
                >
              {% else %}
                {{ 'product-1' | placeholder_svg_tag }}
              {% endif %}
            </div>

            <div class="ajax-quick-shop-card-content">

              <h3 class="ajax-quick-shop-card-title">
                {{ product.title }}
              </h3>

              <div class="ajax-quick-shop-card-price">
                {% if product.compare_at_price > product.price %}
                  <span class="ajax-quick-shop-price">
                    {{ product.price | money }}
                  </span>

                  <span class="ajax-quick-shop-compare-price">
                    {{ product.compare_at_price | money }}
                  </span>
                {% else %}
                  <span class="ajax-quick-shop-price">
                    {{ product.price | money }}
                  </span>
                {% endif %}
              </div>

              <button
                type="button"
                class="ajax-quick-shop-button"
                data-quick-shop-trigger
                data-product-handle="{{ product.handle }}"
                aria-label="Quick shop {{ product.title | escape }}"
              >
                Quick Shop
              </button>

            </div>

          </article>

        {% else %}

          <p class="ajax-quick-shop-empty">
            No products found in this collection.
          </p>

        {% endfor %}
      </div>

    {% else %}

      <p class="ajax-quick-shop-empty">
        Please select a collection from the section settings.
      </p>

    {% endif %}

  </div>
</section>

{% render 'quick-shop-modal' %}

<script>
  window.AjaxQuickShopConfig = {
    currency: {{ shop.currency | json }},
    locale: {{ request.locale.iso_code | json }}
  };
</script>

<script src="{{ 'ajax-quick-shop.js' | asset_url }}" defer></script>

{% schema %}
{
  "name": "AJAX Quick Shop",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop our products"
    },
    {
        "type": "select",
        "id": "heading_alignment",
        "label": "Heading alignment",
        "default": "center",
        "options": [
            {
                "value": "left",
                "label": "Left"
            },
            {
                "value": "center",
                "label": "Center"
            },
            {
                "value": "right",
                "label": "Right"
            }
        ]
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 1,
      "max": 24,
      "step": 1,
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "AJAX Quick Shop"
    }
  ]
}
{% endschema %}
